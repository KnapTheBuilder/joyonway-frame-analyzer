{
  "id": "joyonway_1a1d_family",
  "name": "Joyonway 1A/1D family (P23B32 V2, P20B29, P25B85)",
  "manufacturer": "Joyonway / Mesda",
  "models_compatible": [
    "Joyonway P23B32 V2 (2019)",
    "Joyonway P20B29-2032 V183",
    "Joyonway P25B85"
  ],
  "year": "2019+",
  "status": "validated",
  "contributors": [
    "KDy (unescape table, B4 parser, oscilloscope baudrate validation)",
    "Yannickt26 (P20B29 captures, setpoint frames 38C/10C)",
    "KnapTheBuilder (P23B32 V2 captures, command frames replay validation, HA integration)",
    "Neuro (ESP32+MAX485 prototype on P23B32 V2)",
    "old-man (P25B85 confirmation)"
  ],
  "physical": {
    "baudrate": 38400,
    "data_bits": 8,
    "parity": "none",
    "stop_bits": 1,
    "validation_method": "oscilloscope by KDy (26us/bit period)",
    "w610_485_switch_time_ms_recommended": 10
  },
  "frame_format": {
    "delimiter_start": "0x1A",
    "delimiter_end": "0x1D",
    "pseudo_escape": true,
    "escape_marker": "0x1B",
    "escape_rule_source": "KDy post #90 of community thread",
    "escape_table": {
      "0x1B 0x11": "0x1A",
      "0x1B 0x13": "0x1C",
      "0x1B 0x14": "0x1D",
      "0x1B 0x15": "0x1E",
      "0x1B 0x0B": "0x1B"
    },
    "crc_validation_by_controller": false,
    "crc_replay_safe": true,
    "type_byte_offset_post_unescape": 5
  },
  "addresses": {
    "0x01": "Main controller / mainboard",
    "0x10": "Control panel slot 1 (PB555)",
    "0x11": "Control panel slot 2",
    "0x12": "Control panel slot 3",
    "0x13": "Control panel slot 4",
    "0x20": "WiFi module slot 1",
    "0x21": "WiFi module slot 2",
    "0x30": "Active panel address (most common)",
    "0xFF": "Broadcast"
  },
  "known_types_post_unescape": {
    "0xA1": {
      "name": "Equipment command",
      "description": "Light, pumps, blower, setpoint (panel -> mainboard)",
      "typical_length": 23,
      "direction": "panel -> mainboard"
    },
    "0xA4": {
      "name": "Filtration / planning",
      "description": "Filtration schedule update"
    },
    "0xA5": {
      "name": "Sensor polling",
      "description": "Internal sensor polling (do NOT replay)"
    },
    "0xAA": {
      "name": "Heartbeat",
      "description": "Idle heartbeat (do NOT confuse with off command)"
    },
    "0xB4": {
      "name": "Status broadcast",
      "description": "Temperature, setpoint, equipment states, date/time",
      "frequency_seconds_approx": 1
    }
  },
  "broadcast_b4_decoding_post_unescape": {
    "source": "KDy parser code from post #90",
    "byte_9": {
      "field": "water_temperature_fahrenheit",
      "unit": "degF",
      "conversion_to_celsius": "round((F - 32) * 5 / 9, 1)"
    },
    "byte_12": {
      "field": "pump_state_bitmask",
      "bits": {
        "0x02": "filtration",
        "0x04": "massage"
      }
    },
    "byte_14": {
      "field": "heating_state",
      "values": {
        "0x20": "off (or thermostat manual not activated)",
        "0x40": "cooldown",
        "0x50": "circulation",
        "0x54": "heating",
        "0xC1": "ozonator active (P25B85, KDy observation)"
      }
    },
    "byte_16": {
      "field": "setpoint_fahrenheit",
      "unit": "degF",
      "conversion_to_celsius": "round((F - 32) * 5 / 9, 1)",
      "range": [60, 104]
    },
    "byte_17": {
      "field": "light_and_extras_bitmask",
      "bits": {
        "0x01": "light"
      }
    },
    "byte_27": {
      "field": "filtration_confirmation",
      "values": {
        "0x02": "filtration active"
      }
    },
    "byte_28": {
      "field": "mode_byte",
      "values": {
        "0x20": "normal mode"
      }
    },
    "bytes_53_to_58": {
      "field": "datetime",
      "format": "YYYY (2000+byte) MM DD HH MM SS",
      "purpose": "controller clock"
    }
  },
