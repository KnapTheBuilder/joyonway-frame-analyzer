  "setpoint_command_formula": {
    "description": "To build a custom setpoint command frame, compute Fahrenheit value, place at byte 15",
    "formula_celsius_to_fahrenheit": "byte_15 = round((celsius * 9 / 5) + 32)",
    "examples": {
      "30C": "byte_15 = 0x56 (86F)",
      "35C": "byte_15 = 0x5F (95F)",
      "38C": "byte_15 = 0x64 (100F)",
      "40C": "byte_15 = 0x68 (104F)"
    },
    "warning": "CRC at bytes 17-20 must be recomputed or captured per setpoint value. Replay-safe approach: capture each setpoint value from the panel and store the full frame."
  },
  "manual_thermostat_activation": {
    "discovered_by": "KDy (post #111)",
    "source": "PB555 control panel manual (French)",
    "quote_fr": "Lorsque la fonction manuelle du thermostat est activee, une option de temperature constante sera ajoutee a la barre de menus, permettant a l'utilisateur d'activer manuellement le thermostat dans l'interface principale.",
    "operational_impact": "Without this activation in the PB555 panel menu, no software command can pilot the heater manually. The integration will fail silently on heating commands if this is not done first."
  },
  "manual_ozone_activation": {
    "discovered_by": "KDy",
    "source": "PB555 control panel manual (French)",
    "description": "Ozone disinfection has automatic AND manual modes. Manual mode requires activation in panel menu. When active, byte 14 of B4 broadcast = 0xC1.",
    "applies_to": ["P25B85"]
  },
  "transmission_method": {
    "approach": "replay command frames from panel address 0x30 to mainboard 0x01",
    "repeat_count": 10,
    "interval_ms": 500,
    "rationale": "Bus shared with multiple devices (panels, WiFi modules), repetition improves reliability"
  },
  "important_notes": [
    "Controller does NOT validate CRC, allowing replay of broadcast or captured frames as commands",
    "CMD_ALL_OFF (0xAA type) is actually a heartbeat (captured 90x in 5min idle), not a real off command",
    "P23B32 V2, P20B29 and P25B85 share IDENTICAL protocol byte positions AFTER applying KDy unescape table",
    "Per KDy (post #113), without proper unescape, byte positions shift after the first 0x1B in the frame",
    "Manual heater control requires PB555 menu activation (per official manual)"
  ],
  "community_thread": "https://community.home-assistant.io/t/joyonway-spa-control/582344",
  "frame_analyzer": "https://knapthebuilder.github.io/joyonway-frame-analyzer/",
  "ha_integration": "https://github.com/KnapTheBuilder/ha-joyonway-p23b32"
}
